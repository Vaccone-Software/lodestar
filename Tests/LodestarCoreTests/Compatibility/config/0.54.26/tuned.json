{
  "$schema": "lodestar-schema.json",
  "version": "0.54.26",
  "lode": {
    "tap": false,
    "trigger": "left-command"
  },
  "app": {
    "auto-update": false,
    "channel": "preview",
    "units": "metric"
  },
  "gestures": {
    "scroll": false
  },
  "web": {
    "fallback": "brave:Work",
    "links": {
      "docs": {
        "url": "example.com/docs"
      }
    },
    "routes": {
      "example.com": "brave:Work"
    }
  },
  "scroll": {
    "speed": 2200,
    "step": 80
  },
  "select": {
    "copy-on-complete": true
  },
  "clipboard": {
    "max-size-mb": 200
  },
  "keys": {
    "10": "§"
  },
  "appearance": {
    "eye-comfort": false
  },
  "draft": {
    "editing-style": "vim",
    "words": {
      "Lodestar": true
    }
  },
  "mice": {
    "reversed-wheels": {
      "1133:49271": "Desk Mouse"
    }
  }
}
