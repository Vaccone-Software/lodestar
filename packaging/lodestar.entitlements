<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime is a whitelist: the Info.plist purpose string
	     explains the ask, but only this entitlement permits the asking.
	     Without it macOS answers "denied" on the user's behalf, silently,
	     with no prompt — found by the first person who clicked Allow. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
